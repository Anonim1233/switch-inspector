# ═══════════════════════════════════════════════════════════════════════
# Образ интерфейса: сборка, затем отдача статики
# ═══════════════════════════════════════════════════════════════════════

# ── Сборка ──
FROM node:22-alpine AS build

WORKDIR /app
COPY package*.json ./

# npm ci требует файла с зафиксированными версиями и завершается
# ошибкой без него. Пока файл не создан, используется обычная
# установка — она его как раз и создаст.
#
# Правильно: выполнить `npm install` локально, добавить полученный
# package-lock.json в репозиторий и дальше собирать через npm ci —
# только так версии зависимостей будут одинаковыми при каждой сборке.
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY . .
RUN npm run build

# ── Отдача ──
# В итоговый образ попадает только результат сборки: ни исходников,
# ни зависимостей разработки, ни самого сборщика.
# Вариант образа, рассчитанный на работу без прав администратора:
# обычный требует записи в системные каталоги и слушает порт 80,
# для которого нужны привилегии. Этот слушает 8080 и работает
# от обычного пользователя.
FROM nginxinc/nginx-unprivileged:alpine

COPY --from=build /app/dist /usr/share/nginx/html
# Шаблон, а не готовая конфигурация: образ подставляет в него
# переменные окружения при запуске.
COPY default.conf.template /etc/nginx/templates/default.conf.template

# Значения по умолчанию — для набора контейнеров. В кластере
# переопределяются через настройки развёртывания.
ENV BACKEND_HOST=backend \
    BACKEND_PORT=3000

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8080/ || exit 1

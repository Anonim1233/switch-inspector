# ═══════════════════════════════════════════════════════════════════
# Пример настроек. Скопируйте в .env и заполните значения.
# Файл .env в репозиторий не попадает — он в .gitignore.
# ═══════════════════════════════════════════════════════════════════

# ── Публичный адрес ──────────────────────────────────────────────
# Единая точка настройки при переносе на другой домен: от него
# зависят разрешённый источник запросов и адрес возврата OAuth.
# Указывать без завершающего слеша.
APP_URL=https://switch-inspector.example.ru

# ── Ключ подписи сессионных токенов ──────────────────────────────
# ОБЯЗАТЕЛЕН. Должен быть ОДИНАКОВЫМ у всех реплик приложения,
# иначе токен, выданный одной, не будет принят остальными.
# Сгенерировать: openssl rand -hex 48
JWT_SECRET=

# ── Подключение к базе ───────────────────────────────────────────
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=switch_inventory
PGUSER=switch_inventory
PGPASSWORD=

# Либо строка подключения целиком — тогда переменные выше не нужны:
# DATABASE_URL=postgresql://user:password@host:5432/switch_inventory

# ── Корпоративный вход ───────────────────────────────────────────
# Основной способ входа для всех сотрудников. Без этих значений
# доступен только служебный вход по паролю.
#
# Адрес области, например:
# https://keycloak.company.ru/realms/employees
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Роль, с которой заводится запись при первом входе.
# Права выше назначаются вручную.
OIDC_DEFAULT_ROLE=viewer

# ── Обмен с NetBox ───────────────────────────────────────────────
# Адрес системы, например: https://netbox.company.ru
NETBOX_URL=

# Токены раздельные намеренно: чтение работает постоянно для сверки,
# запись — только при отправке. Право записи можно отозвать,
# не останавливая сверку.
NETBOX_TOKEN_READ=
NETBOX_TOKEN_WRITE=

# Роли устройств, считающихся коммутаторами. Уточнить по справочнику
# NetBox: отбор нужен, чтобы не задеть сервера и питание.
NETBOX_SWITCH_ROLES=access_switch,core_switch,dc_switch,dc_core,dc_san_switch

# Пауза между обращениями при отправке, миллисекунды.
# NetBox — чужая система, нагрузку на неё создавать нельзя.
NETBOX_REQUEST_DELAY_MS=150

# ── Прочее ───────────────────────────────────────────────────────
# Внутренний порт приложения
PORT=3000

# Кому доверять заголовок с настоящим адресом клиента:
#   loopback   — прокси на том же хосте (по умолчанию)
#   10.0.0.0/8 — подсеть входного контроллера в кластере
# От этого зависит, работает ли ограничение частоты по клиентам
# или превращается в общий предел на всех.
TRUSTED_PROXY=loopback
